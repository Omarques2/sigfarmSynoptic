{
  "dataRoles": [
    { "displayName": "Região (ID do SVG)", "displayNameKey": "Visual_Category", "name": "category", "kind": "Grouping" },
    { "displayName": "Legenda", "displayNameKey": "Visual_Legend", "name": "legend", "kind": "Grouping" },
    { "displayName": "Valor", "displayNameKey": "Visual_Measure", "name": "measure", "kind": "Measure" },
    { "displayName": "Tooltips", "displayNameKey": "Visual_Tooltips", "name": "tooltips", "kind": "Measure" }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            { "for": { "in": "category" } },
            { "for": { "in": "legend" } }
          ],
          "dataReductionAlgorithm": { "top": {} }
        },
        "values": {
          "select": [
            { "bind": { "to": "measure" } },
            { "bind": { "to": "tooltips" } }
          ]
        }
      }
    }
  ],
  "objects": {
    "area": {
      "displayName": "Mapa",
      "displayNameKey": "Card_Map",
      "properties": {
        "colorMode": {
          "displayName": "Modo de cor",
          "displayNameKey": "Slice_ColorMode",
          "type": {
            "enumeration": [
              { "displayName": "Tema do Power BI", "value": "Theme" },
              { "displayName": "Cor simples", "value": "Solid" },
              { "displayName": "Gradiente por valor", "value": "Gradient" }
            ]
          }
        },
        "unmatchedFill": {
          "displayName": "Cor (sem correspondência)",
          "displayNameKey": "Slice_UnmatchedFill",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "matchedFill": {
          "displayName": "Cor das áreas",
          "displayNameKey": "Slice_MatchedFill",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "gradientLowFill": {
          "displayName": "Valor baixo",
          "displayNameKey": "Slice_GradientLow",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "gradientMidFill": {
          "displayName": "Valor médio",
          "displayNameKey": "Slice_GradientMid",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "gradientHighFill": {
          "displayName": "Valor alto",
          "displayNameKey": "Slice_GradientHigh",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "nativeAreaColors": {
      "displayName": "Cores condicionais por area",
      "properties": {
        "fill": {
          "displayName": "Cor da area",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "interaction": {
      "displayName": "Interacao",
      "displayNameKey": "Card_Interaction",
      "properties": {
        "autoFocusSelectedArea": { "displayName": "Focar area selecionada", "displayNameKey": "Slice_InteractionAutoFocus", "type": { "bool": true } },
        "focusExternalSelection": { "displayName": "Focar selecao externa", "displayNameKey": "Slice_InteractionExternalFocus", "type": { "bool": true } },
        "focusPadding": { "displayName": "Padding do foco (%)", "displayNameKey": "Slice_InteractionPadding", "type": { "numeric": true } },
        "focusAnimationMs": { "displayName": "Animacao do foco (ms)", "displayNameKey": "Slice_InteractionAnimation", "type": { "numeric": true } },
        "unselectedOpacity": { "displayName": "Opacidade das areas nao selecionadas", "displayNameKey": "Slice_InteractionUnselectedOpacity", "type": { "numeric": true } },
        "labelUnselectedOpacity": { "displayName": "Opacidade dos rotulos nao selecionados", "displayNameKey": "Slice_InteractionLabelUnselectedOpacity", "type": { "numeric": true } }
      }
    },
    "labels": {
      "displayName": "Rotulos avancados",
      "displayNameKey": "Card_ExternalLabels",
      "properties": {
        "labelMode": {
          "displayName": "Modo dos rotulos",
          "displayNameKey": "Slice_LabelMode",
          "type": {
            "enumeration": [
              { "displayName": "Interno", "value": "Inside" },
              { "displayName": "Callout externo", "value": "OutsideCallout" }
            ]
          }
        },
        "labelContent": {
          "displayName": "Conteudo",
          "displayNameKey": "Slice_LabelContent",
          "type": {
            "enumeration": [
              { "displayName": "Valor", "value": "Value" },
              { "displayName": "Categoria", "value": "Category" },
              { "displayName": "Categoria e valor", "value": "CategoryAndValue" }
            ]
          }
        },
        "calloutTextAlign": {
          "displayName": "Alinhamento horizontal",
          "type": {
            "enumeration": [
              { "displayName": "Esquerda", "value": "Left" },
              { "displayName": "Centro", "value": "Center" },
              { "displayName": "Direita", "value": "Right" }
            ]
          }
        },
        "calloutDistance": { "displayName": "Distancia do callout", "displayNameKey": "Slice_CalloutDistance", "type": { "numeric": true } },
        "calloutLineColor": { "displayName": "Cor da linha", "displayNameKey": "Slice_CalloutLineColor", "type": { "fill": { "solid": { "color": true } } } },
        "calloutTextColor": { "displayName": "Cor do texto", "displayNameKey": "Slice_CalloutTextColor", "type": { "fill": { "solid": { "color": true } } } },
        "calloutLineWidth": { "displayName": "Espessura da linha", "displayNameKey": "Slice_CalloutLineWidth", "type": { "numeric": true } },
        "calloutMinGap": { "displayName": "Espaco minimo entre callouts", "type": { "numeric": true } },
        "calloutSideMode": {
          "displayName": "Alinhamento dos callouts",
          "type": {
            "enumeration": [
              { "displayName": "Direita", "value": "Right" },
              { "displayName": "Esquerda", "value": "Left" },
              { "displayName": "Superior", "value": "Top" },
              { "displayName": "Inferior", "value": "Bottom" },
              { "displayName": "Direita ou esquerda", "value": "HorizontalNearest" },
              { "displayName": "Superior ou inferior", "value": "VerticalNearest" },
              { "displayName": "Lado mais proximo", "value": "Nearest" },
              { "displayName": "Usar lados permitidos", "value": "CustomSides" }
            ]
          }
        },
        "calloutRouteStyle": {
          "displayName": "Estilo do conector",
          "displayNameKey": "Slice_CalloutRouteStyle",
          "type": {
            "enumeration": [
              { "displayName": "Curva + reta", "value": "Curved" },
              { "displayName": "Reto", "value": "Straight" }
            ]
          }
        },
        "calloutCurveSize": { "displayName": "Tamanho da curva", "type": { "numeric": true } },
        "calloutAllowRight": { "displayName": "Direita", "displayNameKey": "Slice_CalloutAllowRight", "type": { "bool": true } },
        "calloutAllowLeft": { "displayName": "Esquerda", "displayNameKey": "Slice_CalloutAllowLeft", "type": { "bool": true } },
        "calloutAllowTop": { "displayName": "Cima", "displayNameKey": "Slice_CalloutAllowTop", "type": { "bool": true } },
        "calloutAllowBottom": { "displayName": "Baixo", "displayNameKey": "Slice_CalloutAllowBottom", "type": { "bool": true } }
      }
    },
    "mapRegistry": {
      "displayName": "Registro de mapas",
      "properties": {
        "manifestJson": { "displayName": "Manifesto JSON", "type": { "text": true } }
      }
    },
    "editor": {
      "displayName": "Editor avancado",
      "displayNameKey": "Card_Editor",
      "properties": {
        "enabled": { "displayName": "Habilitar editor", "type": { "bool": true } },
        "showEditorButton": { "displayName": "Mostrar botao Editor", "displayNameKey": "Slice_ShowEditorButton", "type": { "bool": true } },
        "showManifestEditor": { "displayName": "Mostrar manifesto", "type": { "bool": true } }
      }
    },
    "drillMaps": {
      "displayName": "Drill de mapas",
      "displayNameKey": "Card_DrillPath",
      "properties": {
        "enabled": { "displayName": "Habilitar mapas por drill", "displayNameKey": "Slice_DrillEnabled", "type": { "bool": true } },
        "fallbackToDefaultMap": { "displayName": "Usar mapa padrao como fallback", "type": { "bool": true } },
        "noDataBehavior": {
          "displayName": "Areas sem dado no drill",
          "displayNameKey": "Slice_DrillNoDataBehavior",
          "type": {
            "enumeration": [
              { "displayName": "Desvanecer", "value": "Fade" },
              { "displayName": "Ocultar", "value": "Hide" }
            ]
          }
        },
        "focusDataAreas": { "displayName": "Focar areas com dado", "displayNameKey": "Slice_DrillFocusData", "type": { "bool": true } },
        "preFocusSourceOnDrill": { "displayName": "Pre-focar area antes do drill", "type": { "bool": true } },
        "normalizeDrillFocus": { "displayName": "Normalizar foco do drill", "type": { "bool": true } },
        "drillRenderScopeMode": {
          "displayName": "Escopo renderizado no drill",
          "type": {
            "enumeration": [
              { "displayName": "Somente areas com dado", "value": "DrillDataOnly" },
              { "displayName": "Mapa completo", "value": "AllMapAreas" }
            ]
          }
        },
        "drillMinFocusScale": { "displayName": "Zoom minimo do drill", "type": { "numeric": true } },
        "drillFocusPaddingPct": { "displayName": "Padding do drill (%)", "type": { "numeric": true } },
        "drillTargetAreaScreenPx": { "displayName": "Tamanho alvo da area (px)", "type": { "numeric": true } },
        "drillAreaScalePercentile": { "displayName": "Percentil da area alvo", "type": { "numeric": true } },
        "drillMaxFocusScale": { "displayName": "Zoom maximo do drill", "type": { "numeric": true } }
      }
    },
    "labelOverrides": {
      "displayName": "Overrides de rotulos",
      "properties": {
        "overridesJson": { "displayName": "Overrides JSON", "type": { "text": true } }
      }
    },
    "svgSettings": {
      "displayName": "SVG",
      "properties": {
        "svgText": { "displayName": "Conteúdo SVG (texto/Data URI)", "type": { "text": true } },
        "defaultFill": { "displayName": "Cor padrão (legado)", "type": { "fill": { "solid": { "color": true } } } },
        "alwaysShowWarning": { "displayName": "Sempre mostrar aviso de sanitização", "type": { "bool": true } },

        "labelShow": { "displayName": "Mostrar rótulos (Valor)", "type": { "bool": true } },
        "labelMin": { "displayName": "Tamanho mínimo (px)", "type": { "numeric": true } },
        "labelMax": { "displayName": "Tamanho máximo (px)", "type": { "numeric": true } },
        "labelBold": { "displayName": "Negrito", "type": { "bool": true } },
        "labelOutlineFactor": { "displayName": "Contorno (% do tamanho)", "type": { "numeric": true } },
        "labelScaleMode": {
          "displayName": "Escala do rótulo",
          "type": {
            "enumeration": [
              { "displayName": "Tamanho fixo na tela", "value": "FixedScreenSize" },
              { "displayName": "Escalar com o mapa", "value": "ScaleWithMap" }
            ]
          }
        },
        "labelMinScreenPx": { "displayName": "Mínimo na tela (px)", "type": { "numeric": true } },
        "labelMaxScreenPx": { "displayName": "Máximo na tela (px)", "type": { "numeric": true } },
        "labelHideBelowAreaPx": { "displayName": "Ocultar se área menor que (px)", "type": { "numeric": true } },
        "labelDenseMode": {
          "displayName": "Rótulos em mapas densos",
          "type": {
            "enumeration": [
              { "displayName": "Somente com dados", "value": "DataOnly" },
              { "displayName": "Somente selecionadas", "value": "SelectedOnly" },
              { "displayName": "Ocultar", "value": "Hidden" },
              { "displayName": "Todos", "value": "All" }
            ]
          }
        }
      }
    },
    "performance": {
      "displayName": "Performance",
      "properties": {
        "denseModeEnabled": { "displayName": "Modo denso automático", "type": { "bool": true } },
        "denseAreaThreshold": { "displayName": "Limite de áreas para modo denso", "type": { "numeric": true } }
      }
    },
    "outline": {
      "displayName": "Contorno",
      "displayNameKey": "Card_Outline",
      "properties": {
        "show": { "displayName": "Mostrar", "displayNameKey": "Slice_OutlineShow", "type": { "bool": true } },
        "color": { "displayName": "Cor", "displayNameKey": "Slice_OutlineColor", "type": { "fill": { "solid": { "color": true } } } },
        "width": { "displayName": "Espessura (px)", "displayNameKey": "Slice_OutlineWidth", "type": { "numeric": true } }
      }
    },
    "legend": {
      "displayName": "Legenda",
      "displayNameKey": "Card_Legend",
      "properties": {
        "show": { "displayName": "Mostrar", "displayNameKey": "Slice_LegendShow", "type": { "bool": true } },
        "position": {
          "displayName": "Posicao",
          "displayNameKey": "Slice_LegendPosition",
          "type": {
            "enumeration": [
              { "displayName": "Superior", "value": "Top" },
              { "displayName": "Inferior", "value": "Bottom" },
              { "displayName": "Esquerda", "value": "Left" },
              { "displayName": "Direita", "value": "Right" }
            ]
          }
        },
        "title": { "displayName": "Titulo", "displayNameKey": "Slice_LegendTitle", "type": { "text": true } },
        "labelColor": { "displayName": "Cor do texto", "displayNameKey": "Slice_LegendLabelColor", "type": { "fill": { "solid": { "color": true } } } },
        "fontSize": { "displayName": "Tamanho do texto (px)", "displayNameKey": "Slice_LegendFontSize", "type": { "numeric": true } }
      }
    },
    "help": {
      "displayName": "Ajuda",
      "properties": {
        "show": { "displayName": "Mostrar dicas", "type": { "bool": true } }
      }
    },
    "warning": {
      "displayName": "Avisos",
      "properties": {
        "show": { "displayName": "Mostrar avisos de sanitização", "type": { "bool": true } }
      }
    },
    "ui": {
      "displayName": "Interface",
      "properties": {
        "language": {
          "displayName": "Idioma",
          "type": {
            "enumeration": [
              { "displayName": "Auto (sistema)", "value": "auto" },
              { "displayName": "Português", "value": "pt" },
              { "displayName": "English", "value": "en" }
            ]
          }
        }
      }
    }
  },
  "sorting": { "default": {} },
  "supportsKeyboardFocus": true,
  "supportsHighlight": true,
  "drilldown": {
    "roles": ["category"],
    "canDisableDrill": {}
  },
  "suppressDefaultTitle": false,
  "advancedEditModeSupport": 2,
  "privileges": [
    {
      "name": "LocalStorage",
      "essential": false
    }
  ]
}
