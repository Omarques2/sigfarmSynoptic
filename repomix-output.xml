.sp-editor-drill-branch-node.is-automatic .sp-editor-drill-branch-dot {
    background: #ffffff;
    outline-style: dashed;
    outline-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.08);
}

.sp-editor-drill-branch-node.is-none .sp-editor-drill-branch-dot {
    background: #ffffff;
    outline-style: dashed;
    outline-color: #94a3b8;
    box-shadow: none;
}

.sp-editor-drill-branch-node.is-error .sp-editor-drill-branch-dot {
    background: #dc2626;
    outline-color: #dc2626;
    box-shadow: 0 0 0 5px rgba(220, 38, 38, 0.12);
}

.sp-editor-drill-branch-label {
    position: relative;
    z-index: 3;
    min-width: 0;
    width: max-content;
    max-width: 230px;
    padding: 0;
    background: transparent;
    border-radius: 0;
    pointer-events: none;
    justify-self: start;
}

.sp-editor-drill-branch-label strong {
    display: block;
    overflow: hidden;
    width: max-content;
    max-width: 230px;
    padding-right: 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.92);
    color: #17233a;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sp-editor-drill-branch-label span {
    display: block;
    overflow: hidden;
    width: max-content;
    max-width: 230px;
    padding-right: 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.92);
    margin-top: 3px;
    color: #5b6b83;
    font-size: 12px;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sp-editor-drill-branch-label .sp-editor-drill-branch-map-link {
    cursor: pointer;
    pointer-events: auto;
}

.sp-editor-drill-branch-label .sp-editor-drill-branch-map-link:hover {
    color: #0f766e;
    text-decoration: underline;
}

.sp-editor-drill-branch-node.is-clickable:hover .sp-editor-drill-branch-label strong {
    color: #0f766e;
    text-decoration: underline;
}

.sp-editor-drill-branch-node.is-clickable:hover .sp-editor-drill-branch-dot {
    box-shadow: 0 0 0 6px rgba(15, 148, 136, 0.18);
}

.sp-editor-drill-branch-node.is-clickable:hover .sp-editor-drill-branch-label {
    background: transparent;
}

.sp-editor-drill-node-badge {
    display: inline-flex;
    align-items: center;
    margin-top: 6px;
    padding: 2px 6px;
    border-radius: 999px;
    background: #e8f8f5;
    color: #08756d;
    font-size: 11px;
    font-weight: 800;
}

.sp-editor-drill-node-error {
    margin-top: 6px;
    color: #b91c1c;
    font-size: 11px;
    font-weight: 700;
}

.sp-editor-drill-edge-label {
    position: absolute;
    z-index: 2;
    max-width: 160px;
    overflow: hidden;
    border: 1px solid #d8e3f2;
    border-radius: 999px;
    background: #ffffff;
    padding: 3px 8px;
    color: #17233a;
    font-size: 12px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
    transform: translate(-50%, -50%);
}

.sp-editor-drill-level-markers {
    position: relative;
    height: 34px;
    min-width: 100%;
    pointer-events: none;
}

.sp-editor-drill-level-marker {
    position: absolute;
    top: 10px;
    color: #5b6b83;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transform: none;
    white-space: nowrap;
}

.sp-editor-drill-flow-row {
    display: grid;
    grid-template-columns: 150px minmax(120px, 1fr) 210px;
    column-gap: 12px;
    row-gap: 6px;
    align-items: center;
    min-height: 50px;
    margin: 4px 0;
}

.sp-editor-drill-source {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #17233a;
    font-weight: 800;
}

.sp-editor-drill-dot {
    display: inline-block;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    border: 2px solid #ffffff;
    border-radius: 50%;
    background: #0f9488;
    box-shadow: 0 0 0 2px #0f9488;
}

.sp-editor-drill-dot.is-root {
    width: 22px;
    height: 22px;
}

.sp-editor-drill-connection {
    position: relative;
    height: 16px;
    padding: 0;
    border: 0;
    border-top: 2px solid #0f9488;
    background: transparent;
    cursor: pointer;
}

.sp-editor-drill-connection::after {
    content: "";
    position: absolute;
    top: -7px;
    right: -9px;
    width: 10px;
    height: 10px;
    border: 3px solid #3b79ff;
    border-radius: 50%;
    background: #ffffff;
}

.sp-editor-drill-node {
    padding: 6px 8px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    text-align: left;
    cursor: pointer;
}

.sp-editor-drill-node:hover,
.sp-editor-drill-connection:hover {
    background: #f3f7fb;
}

.sp-editor-drill-node em {
    display: inline-block;
    margin-top: 4px;
    padding: 1px 5px;
    border: 1px solid #9edbd2;
    border-radius: 6px;
    background: #f2fbf9;
    color: #08756d;
    font-size: 11px;
    font-style: normal;
}

.sp-editor-drill-flow-row.is-automatic .sp-editor-drill-dot {
    background: #ffffff;
}

.sp-editor-drill-flow-row.is-automatic .sp-editor-drill-connection {
    border-color: #8aa3c5;
    border-top-style: dashed;
}

.sp-editor-drill-flow-row.is-none .sp-editor-drill-dot {
    background: #ffffff;
    box-shadow: 0 0 0 2px #b7c1cf;
}

.sp-editor-drill-flow-row.is-none .sp-editor-drill-connection {
    border-color: #c7d0dc;
    border-top-style: dotted;
}

.sp-editor-drill-flow-row.is-none .sp-editor-drill-node strong {
    color: #7a8798;
}
.sp-editor-drill-inline-editor {
    display: none;
    grid-column: 2 / 4;
    padding: 8px 10px;
    border: 1px solid #d8e3f2;
    border-radius: 10px;
    background: #f8fbff;
}

.sp-editor-drill-flow-row.is-editing .sp-editor-drill-inline-editor {
    display: block;
}

.sp-editor-drill-inline-editor label {
    display: grid;
    grid-template-columns: 96px minmax(150px, 1fr);
    gap: 8px;
    align-items: center;
    color: #5b6b83;
    font-weight: 700;
}

.sp-editor-drill-target-select {
    min-height: 34px;
    font-size: 12px;
}

.sp-editor-drill-more {
    margin: 10px 0 0 150px;
}

.sp-editor-drill-empty {
    padding: 18px;
    color: #5b6b83;
}

.sp-editor-drill-preview-legend-bar {
    display: none;
}

.sp-editor-drill-preview-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #52627a;
    font-size: 12px;
    font-weight: 700;
}

.sp-editor-drill-level-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 7px;
    background: #0f9488;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
}

.sp-editor-drill-level-badge.is-level-2 {
    background: #477cff;
}

.sp-editor-drill-level-badge.is-level-3 {
    background: #8b5cf6;
}

.sp-editor-drill-level-badge.is-level-4 {
    background: #d6dee9;
    color: #536176;
}

.sp-editor-drill-config {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(280px, 31%, 340px);
    gap: 20px;
    align-items: stretch;
    min-height: 0;
}

.sp-editor-drill-config-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 14px;
}

.sp-editor-drill-config-card h4,
.sp-editor-drill-details h4 {
    margin: 0;
    color: #10203a;
    font-size: 16px;
}

.sp-editor-drill-config-card > p {
    margin: 4px 0 10px;
    color: #5b6b83;
    font-size: 12px;
}

.sp-editor-drill-config-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
    margin-bottom: 10px;
}

.sp-editor-drill-config-toolbar.is-search-only {
    display: grid;
    grid-template-columns: minmax(220px, 1fr);
    gap: 10px;
}

.sp-editor-drill-config-search {
    width: 100%;
    height: 34px;
    border: 1px solid #cbd8ea;
    border-radius: 8px;
    padding: 0 10px;
    color: #10203a;
    font-size: 12px;
}

.sp-editor-drill-filter {
    height: 32px;
    border: 1px solid #d8e3f2;
    border-radius: 8px;
    background: #ffffff;
    color: #5b6b83;
    font-size: 11px;
    font-weight: 800;
    padding: 0 9px;
    cursor: pointer;
}

.sp-editor-drill-filter.is-active {
    border-color: #0f9488;
    background: #e8f8f5;
    color: #08756d;
}

.sp-editor-drill-config-batch {
    margin-left: auto;
}

.sp-editor-drill-config-table {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    border: 1px solid #e4ebf5;
    border-radius: 10px;
    overflow: hidden;
}

.sp-editor-drill-config-header,
.sp-editor-drill-config-row {
    display: grid;
    grid-template-columns: 44px 120px minmax(240px, 1fr) 140px 40px;
    gap: 12px;
    align-items: center;
    padding: 0 14px;
}

.sp-editor-drill-config-header {
    min-height: 34px;
    background: #f8fbff;
    color: #5b6b83;
    font-size: 11px;
    font-weight: 800;
}

.sp-editor-drill-config-body {
    max-height: none;
    overflow-y: auto;
}

.sp-editor-drill-config-row {
    min-height: 58px;
    border-top: 1px solid #e4ebf5;
    color: #17233a;
    font-size: 12px;
    cursor: pointer;
}

.sp-editor-drill-config-row.is-search-hidden {
    display: none !important;
}

.sp-editor-drill-config-row.is-selected {
    background: #e8f8f5;
}

.sp-editor-drill-config-table.is-empty-search {
    opacity: 0.72;
}

.sp-editor-drill-config-area {
    font-weight: 800;
}

.sp-editor-drill-config-select {
    width: 100%;
    min-height: 32px;
    font-size: 12px;
}

.sp-editor-drill-row-menu {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #5b6b83;
    cursor: pointer;
}

.sp-editor-drill-row-menu:hover {
    background: #f3f7fb;
}

.sp-editor-drill-status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 22px;
    padding: 0 7px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
}

.sp-editor-drill-status-badge.is-manual {
    border-color: #9edbd2;
    background: #e8f8f5;
    color: #08756d;
}

.sp-editor-drill-status-badge.is-automatic {
    border-color: #b9ccff;
    background: #f4f7ff;
    color: #3769d6;
}

.sp-editor-drill-status-badge.is-none {
    border-color: #d8e3f2;
    background: #f3f7fb;
    color: #5b6b83;
}

.sp-editor-drill-config-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    color: #5b6b83;
    font-size: 12px;
}

.sp-editor-drill-config-empty {
    padding: 18px;
    color: #5b6b83;
    font-size: 12px;
    text-align: center;
}

.sp-editor-drill-details {
    padding: 14px;
    overflow: auto;
}

.sp-editor-drill-detail-header {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 10px 0 12px;
}

.sp-editor-drill-area-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #0f9488;
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
}

.sp-editor-drill-detail-title {
    margin: 0;
    color: #10203a;
    font-size: 14px;
    font-weight: 800;
}

.sp-editor-drill-detail-subtitle {
    display: block;
    margin-top: 2px;
    color: #6b7a90;
    font-size: 11px;
    font-weight: 500;
}

.sp-editor-drill-detail-field {
    margin-bottom: 10px;
}

.sp-editor-drill-detail-field span {
    display: block;
    margin-bottom: 4px;
    color: #5b6b83;
    font-size: 11px;
}

.sp-editor-drill-detail-field strong {
    display: block;
    overflow: hidden;
    color: #10203a;
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sp-editor-drill-details h5 {
    margin: 10px 0 7px;
    color: #10203a;
    font-size: 12px;
}

.sp-editor-drill-details-separator {
    margin: 12px 0;
    border: 0;
    border-top: 1px solid #e4ebf5;
}

.sp-editor-drill-geometry-preview {
    height: 180px;
    overflow: hidden;
    border: 1px solid #d8e3f2;
    border-radius: 12px;
    background-color: #ffffff;
    background-image:
        linear-gradient(#e4ebf5 1px, transparent 1px),
        linear-gradient(90deg, #e4ebf5 1px, transparent 1px);
    background-size: 18px 18px;
    padding: 8px;
}

.sp-editor-drill-geometry-preview svg {
    width: 100%;
    height: 100%;
    display: block;
}

.sp-editor-svg-measure-sandbox {
    contain: layout style paint;
}

.sp-editor-drill-geometry-empty {
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    text-align: center;
}

.sp-editor-drill-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 14px;
    min-height: 48px;
}

.sp-editor-drill-geometry-caption {
    margin: 6px 0 0;
    color: #5b6b83;
    font-size: 11px;
}

.sp-editor-drill-relation {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: #10203a;
    font-size: 12px;
}

.sp-editor-drill-relation-origin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #0f9488;
    color: #ffffff;
    font-weight: 800;
}

.sp-editor-drill-relation-arrow {
    color: #5b6b83;
    font-weight: 800;
}

.sp-editor-drill-relation-target {
    min-width: 0;
    overflow: hidden;
    padding: 6px 8px;
    border: 1px solid #9edbd2;
    border-radius: 8px;
    background: #e8f8f5;
    color: #08756d;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sp-editor-drill-detail-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    color: #5b6b83;
    text-align: center;
}

.sp-editor-svg-overlay {
    align-items: stretch;
    justify-content: center;
    padding: 28px 32px 92px;
    box-sizing: border-box;
    background: #ffffff;
}

.sp-editor-svg-modal {
    width: min(100%, 1220px);
    max-width: 1220px;
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    gap: 14px;
    padding: 20px;
    box-sizing: border-box;
    border: 1px solid #d8e3ef;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: none;
    overflow: hidden;
}

.sp-editor-svg-modal.is-create {
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
}

.sp-editor-svg-modal .sp-editor-footer {
    padding: 0;
    border-top: 0;
    background: transparent;
}

.sp-editor-svg-name-label {
    display: grid;
    gap: 6px;
    padding: 0;
    color: #172033;
    font-size: 12px;
    font-weight: 700;
}

.sp-editor-svg-name-label input {
    height: 42px;
    border: 1px solid #d4dfeb;
    border-radius: 10px;
    padding: 0 12px;
    font-size: 12px;
    outline: none;
}

.sp-editor-overlay-header,
.sp-editor-svg-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.sp-editor-svg-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.sp-editor-svg-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid #dde4eb;
    background: #f8fafc;
    color: #5c6f83;
    font-size: 12px;
}

.sp-editor-codeframe {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    min-height: 0;
    height: 100%;
    border: 1px solid #cfd9e6;
    border-radius: 14px;
    overflow: hidden;
    background: #ffffff;
}

.sp-editor-svg-gutter {
    margin: 0;
    min-height: 0;
    height: 100%;
    box-sizing: border-box;
    padding: 16px 12px;
    text-align: right;
    user-select: none;
    color: #718198;
    background: #f4f7fb;
    border-right: 1px solid #d8e3ef;
    font-family: Consolas, "Courier New", monospace;
    font-size: 13px;
    line-height: 1.6;
    overflow: hidden;
}

.sp-editor-svg-textarea {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-height: 0;
    border: none;
    border-radius: 0;
    padding: 16px;
    resize: none;
    overflow: auto;
    font-family: Consolas, "Courier New", monospace;
    font-size: 13px;
    line-height: 1.6;
    color: #172033;
    background: #ffffff;
}

.sp-editor-overlay-form > .sp-editor-checkbox {
    grid-column: 1 / -1;
}

.sp-editor-overlay-footer,
.sp-editor-footer {
    justify-content: flex-end;
}

@media (max-width: 760px) {
    .sp-editor-browser,
    .sp-editor-detail-main,
    .sp-editor-drill-main,
    .sp-editor-drill-config {
        grid-template-columns: 1fr;
    }

    .sp-editor-overlay-form {
        grid-template-columns: 1fr;
    }

    .sp-editor-detail-sidebar {
        grid-template-rows: auto minmax(180px, 220px) minmax(220px, auto);
    }

    .sp-editor-svg-modal {
        height: 100%;
    }
}
