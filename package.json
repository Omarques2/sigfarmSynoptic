{
  "name": "sigfarm-geosynoptic",
  "description": "Power BI custom visual for SVG synoptic maps with theme colors, conditional fills, labels, drill-aware map registry, and certified-safe SVG sanitization.",
  "version": "1.0.0.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omarques2/sigfarmSynoptic.git"
  },
  "homepage": "https://github.com/Omarques2/sigfarmSynoptic/tree/certification",
  "bugs": {
    "url": "https://github.com/Omarques2/sigfarmSynoptic/issues"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "license": "MIT",
  "scripts": {
    "pbiviz": "npx pbiviz",
    "start": "npx pbiviz start",
    "package": "npx pbiviz package",
    "package:audit": "npx pbiviz package --certification-audit",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint": "npm run eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm audit --audit-level=moderate && npm run package:audit && npm run package"
  },
  "dependencies": {
    "@types/d3": "7.4.3",
    "d3": "7.9.0",
    "powerbi-visuals-api": "~5.10.0",
    "powerbi-visuals-utils-formattingmodel": "6.0.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "powerbi-visuals-tools": "^7.0.3",
    "typescript": "5.5.4"
  }
}
